# Copy to .env and fill in what you use. Never commit .env.
# Only the variables below are read by the code (directly or via SDKs).

# --- LLM agents (review, debate, deep research) -------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Web search for the deep-research agent (gpt-researcher)
TAVILY_API_KEY=

# --- Market / fundamentals data ------------------------------------------------
FMP_API_KEY=
POLYGON_API_KEY=
ALPHAVANTAGE_API_KEY=
FINNHUB_API_KEY=

# --- SEC EDGAR -----------------------------------------------------------------
# Required by the SEC: a real "Name email@domain" contact. Requests with a
# placeholder contact may be throttled or blocked.
SEC_API_USER_AGENT=Your Name you@example.com

# --- Optional alt-data adapters ------------------------------------------------
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
